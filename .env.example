# Copy to .env for local development (.env is git-ignored and loaded by the dev profile).
# In production set these as real environment variables in your hosting provider.

# Spring profile: dev (default) | prod
SPRING_PROFILES_ACTIVE=dev
PORT=5454

# PostgreSQL: either DB_URL, or DB_HOST/DB_PORT/DB_NAME
# DB_URL=jdbc:postgresql://localhost:5432/ecommerce
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USERNAME=bazaarly
DB_PASSWORD=

# JWT signing secret, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Razorpay TEST mode keys (https://dashboard.razorpay.com/app/keys, test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Admin account, created or promoted to ROLE_ADMIN on startup (password: 8+ characters).
# Admins cannot sign up through the API; this is the only way to get one.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cache for the catalog endpoints: redis (prod default) | simple (in-memory, dev default) | none
CACHE_TYPE=simple
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
# Safety-net TTLs (ISO-8601 durations); entries are also evicted on every change
CACHE_CATALOG_TTL=PT10M
CACHE_PRODUCT_TTL=PT30M

# Order-confirmation emails. false = only log them. Locally: Mailpit (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit)
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Bazaarly <orders@bazaarly.local>

# Rate limits per client IP on /auth/signin and /auth/signup (429 when exceeded)
RATE_LIMIT_SIGNIN_REQUESTS=10
RATE_LIMIT_SIGNIN_PERIOD=PT1M
RATE_LIMIT_SIGNUP_REQUESTS=5
RATE_LIMIT_SIGNUP_PERIOD=PT10M
# framework = take the client IP from X-Forwarded-For. Only behind a trusted proxy (prod default).
FORWARD_HEADERS_STRATEGY=none
# Swagger UI / OpenAPI document
API_DOCS_ENABLED=true

# Unpaid orders release their reserved stock (and their payment link expires) after this (ISO-8601, >= PT20M)
ORDER_RESERVATION_TTL=PT60M

# Optional public demo accounts for reviewers: a shopper, and a read-only admin (ROLE_ADMIN_VIEWER)
DEMO_SHOPPER_EMAIL=
DEMO_SHOPPER_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Comma-separated origins allowed by CORS, and the storefront URL used for payment redirects
# Load the 499 demo products into an empty catalog on startup
SEED_ENABLED=true

CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
