# Copy to .env for local development (.env is git-ignored and loaded by the dev profile).
# In production set these as real environment variables in your hosting provider.

# Spring profile: dev (default) | prod
SPRING_PROFILES_ACTIVE=dev
PORT=5454

# PostgreSQL: either DB_URL, or DB_HOST/DB_PORT/DB_NAME
# DB_URL=jdbc:postgresql://localhost:5432/ecommerce
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USERNAME=bazaarly
DB_PASSWORD=

# JWT signing secret, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Razorpay TEST mode keys (https://dashboard.razorpay.com/app/keys, test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Admin account, created or promoted to ROLE_ADMIN on startup (password: 8+ characters).
# Admins cannot sign up through the API; this is the only way to get one.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cache for the catalog endpoints: redis (prod default) | simple (in-memory, dev default) | none
CACHE_TYPE=simple
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
# Safety-net TTLs (ISO-8601 durations); entries are also evicted on every change
CACHE_CATALOG_TTL=PT10M
CACHE_PRODUCT_TTL=PT30M

# Comma-separated origins allowed by CORS, and the storefront URL used for payment redirects
# Load the 499 demo products into an empty catalog on startup
SEED_ENABLED=true

CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
